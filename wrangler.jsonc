{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mv-music",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "MUSIC_PROVIDERS": "audius,jamendo",
    "JAMENDO_CLIENT_ID": "279c84a9",
    "AUDIUS_API_KEY": "0x97597c1727ef22c0a6cc8bf5ebe34d795514ff9f"
  }
}
